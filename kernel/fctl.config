# What fctl adds to Firecracker's guest configuration. Later lines win.

# The kernel's configuration in /proc/config.gz, for agents that need to
# know what their sandbox's kernel can do.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# 9p over a file descriptor (trans=fd), for the package caches a project's
# sandboxes share: the host serves them over the VM's vsock, and fctl-agent
# mounts the connection at /var/cache/fctl. Firecracker has no virtio-fs or
# virtio-9p.
CONFIG_NET_9P=y
CONFIG_NET_9P_FD=y
CONFIG_9P_FS=y
